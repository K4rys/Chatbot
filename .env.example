# ---- IA utilisée : ollama (local, gratuit, privé) ou gemini (offre gratuite de Google) ----
SGO_FOURNISSEUR=ollama

# Gemini uniquement : clé gratuite sur https://aistudio.google.com (ne jamais la committer)
SGO_API_KEY=

# Facultatif : changer de modèle (défaut ollama = qwen2.5:7b, gemini = gemini-3.8-flash)
# SGO_MODELE=
# Facultatif : tout autre service compatible OpenAI (Mistral, Groq, LM Studio…)
# SGO_API_URL=

# ---- Identité affichée par l'assistant ----
SGO_CONSEILLER=Sébastien
SGO_CONTACT=email@exemple.fr · 06 00 00 00 00 · lien de prise de rendez-vous

# ---- Garde-fous ----
SGO_MAX_MESSAGES=40
SGO_MAX_CHARS=6000
SGO_RATE_LIMIT_HOUR=60

# Journal des conversations (logs/conversations-AAAA-MM-JJ.jsonl) : 1 = activé, 0 = désactivé
SGO_LOG_CONVERSATIONS=1
