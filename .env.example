# Clé API Anthropic (console.anthropic.com) — ne jamais la committer
ANTHROPIC_API_KEY=

# Identité affichée par l'assistant
SGO_CONSEILLER=Sébastien
SGO_CONTACT=email@exemple.fr · 06 00 00 00 00 · lien de prise de rendez-vous

# Modèle et niveau de réflexion (low | medium | high | xhigh | max)
SGO_MODEL=claude-opus-5-5
SGO_EFFORT=medium

# Garde-fous
SGO_MAX_MESSAGES=40
SGO_MAX_CHARS=6000
SGO_RATE_LIMIT_HOUR=60

# Journal des conversations (logs/conversations-AAAA-MM-JJ.jsonl) : 1 = activé, 0 = désactivé
SGO_LOG_CONVERSATIONS=1

# --- Pilotage MDB en ligne (/pilotage) ---
# Base des comptes et des données (fichier SQLite sur un disque persistant de l'hébergeur)
PILOTAGE_DB=data/pilotage.sqlite3
# Premier compte administrateur, créé au démarrage si aucun compte n'existe (retirer ensuite)
PILOTAGE_ADMIN_LOGIN=
PILOTAGE_ADMIN_MDP=
# Cookie réservé au HTTPS : laisser 1 en production
PILOTAGE_COOKIE_SECURE=1
# Jeton de la synchronisation Drive quotidienne (40 caractères aléatoires) ; ne jamais le committer
PILOTAGE_SYNC_TOKEN=
